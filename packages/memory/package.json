{
  "name": "@repomem/memory",
  "version": "0.1.2",
  "description": "Your repo's memory, available to every AI tool your team uses. A local MCP server that turns a memory/ folder into searchable shared context.",
  "license": "MIT",
  "author": "Nicolás Rickert",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "repomem-memory": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./setup": "./dist/setup/spec.js"
  },
  "files": [
    "dist",
    "templates",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicorickert/repomem.git",
    "directory": "packages/memory"
  },
  "homepage": "https://github.com/nicorickert/repomem/tree/main/packages/memory#readme",
  "bugs": {
    "url": "https://github.com/nicorickert/repomem/issues"
  },
  "keywords": [
    "repomem",
    "mcp",
    "memory",
    "ai",
    "context",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@repomem/core": "^0.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.1.0",
    "picomatch": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
