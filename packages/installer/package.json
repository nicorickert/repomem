{
  "name": "@repomem/cli",
  "version": "0.1.2",
  "description": "One-command installer for repomem: interactively configure the memory and structure-map MCP servers for your AI tool.",
  "license": "MIT",
  "author": "Nicolás Rickert",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "repomem": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicorickert/repomem.git",
    "directory": "packages/installer"
  },
  "homepage": "https://github.com/nicorickert/repomem/tree/main/packages/installer#readme",
  "bugs": {
    "url": "https://github.com/nicorickert/repomem/issues"
  },
  "keywords": [
    "repomem",
    "mcp",
    "installer",
    "setup",
    "ai",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build -w @repomem/core && npm run build -w @repomem/memory && npm run build -w @repomem/map",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@repomem/core": "^0.1.0",
    "@repomem/map": "^0.1.0",
    "@repomem/memory": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
