{
  "name": "repomem",
  "version": "0.1.0",
  "description": "Your repo's memory, available to every AI tool your team uses. A local MCP server that turns a memory/ folder into searchable shared context.",
  "license": "MIT",
  "author": "Nicolás Rickert",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repomem": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.1.0",
    "picomatch": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
